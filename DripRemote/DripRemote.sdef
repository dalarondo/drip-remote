<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dictionary SYSTEM "file://localhost/System/Library/DTDs/sdef.dtd">
<dictionary title="Drip Remote Terminology">
    <suite name="Drip Remote Suite" code="dRpR" description="Control the connected Apple TV.">
        <command name="pause" code="dRpRpaus"
                 description="Pause playback on the connected Apple TV. No-op if nothing is currently playing.">
            <cocoa class="DRPPauseScriptCommand"/>
        </command>
        <command name="play" code="dRpRplay"
                 description="Resume playback on the connected Apple TV. No-op if nothing is loaded or it is already playing.">
            <cocoa class="DRPPlayScriptCommand"/>
        </command>
    </suite>
</dictionary>
